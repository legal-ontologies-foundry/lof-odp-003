# Assignment under Option A with legal relations (decision record, Option A+).
# Northside assigns its claim to rent to a collection agency. Northside's claim
# ends; a new claim, held by the agency, concretizes the same legal relation.
# Expected: consistent under Option A, with the agency holding a claim that is
# the continuation of Northside's claim in the only sense the law requires.
@prefix ex:   <https://example.org/lease/> .
@prefix lof:  <https://w3id.org/lof/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/lof/odp-003/examples/assignment-test-legal-relation.ttl> a owl:Ontology .

ex:agency a obo:BFO_0000040 ; rdfs:label "Metro Collections Inc." .
ex:aprilRentObligation a lof:ODP003_0001011 ; rdfs:label "the April rent obligation" ;
  obo:BFO_0000058 ex:anaAprilRentDuty , ex:northsideAprilRentClaim , ex:agencyAprilRentClaim .
ex:agencyAprilRentClaim a lof:ODP003_0001001 ; rdfs:label "agency's claim to April rent" ;
  lof:ODP003_0001100 ex:agency ; lof:ODP003_0001101 ex:leaseTerms ;
  lof:ODP003_0001102 ex:anaAprilRentDuty ;
  lof:ODP004_0001100 ex:assignment .
ex:assignment a lof:ODP001_0001000 ; rdfs:label "assignment of the rent claim, 10 April" ;
  obo:BFO_0000057 ex:northside , ex:agency .
[] a owl:AllDifferent ; owl:distinctMembers ( ex:ana ex:northside ex:agency ) .
[] a owl:AllDifferent ; owl:distinctMembers ( ex:northsideAprilRentClaim ex:agencyAprilRentClaim ) .
