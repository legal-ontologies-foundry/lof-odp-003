# Assignment modeled with 'succeeds' (0.2.0). Northside assigns its claim to
# rent to a collection agency: Northside's claim ends and a new claim, held by
# the agency, succeeds it. Consistent; the earlier assignment-test.ttl (one
# claim, two holders) remains inconsistent by design.
@prefix ex:   <http://example.org/lof/lease/> .
@prefix odp1: <https://w3id.org/lof/ODP001_> .
@prefix odp3: <https://w3id.org/lof/ODP003_> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/lof/assignment-succession> a owl:Ontology .

ex:agency a obo:BFO_0000040 ; rdfs:label "Metro Collections Inc." .
ex:assignmentDeed a odp1:0001002 ; rdfs:label "deed of assignment" .
ex:assignment a odp1:0001000 ; rdfs:label "Northside assigns the rent claim" ;
  obo:BFO_0000057 ex:northside , ex:agency ;
  odp1:0001103 ex:assignmentDeed .
ex:agencyRentClaim a odp3:0001001 ;
  rdfs:label "the agency's claim to monthly rent" ;
  odp3:0001100 ex:agency ;
  odp3:0001101 ex:tenantCode ;
  odp3:0001104 ex:northsideRentClaim .
[] a owl:AllDifferent ; owl:distinctMembers ( ex:ana ex:northside ex:agency ) .
